{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "日页",
  "version": "0.2.0",
  "identifier": "com.personal.daypage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "日页 · 待办",
        "width": 340,
        "height": 430,
        "minWidth": 280,
        "minHeight": 200,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "journal",
        "create": false,
        "title": "日页 · 日记与日历",
        "url": "index.html?view=journal",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
